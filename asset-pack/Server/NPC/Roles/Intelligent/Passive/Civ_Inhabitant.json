{
  "Type": "Generic",
  "StartState": "Idle",
  "DisplayNames": [
    "Bewohner"
  ],
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "Player",
  "CombatConfig": "CAE_Civ_Soldier",
  "MaxHealth": 74,
  "DisableDamageGroups": [
    "Self"
  ],
  "KnockbackScale": 0.5,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 7,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "$Comment": "A Civ-selected target is mirrored into native TargetMemory before entering the native Combat state.",
          "Sensor": {
            "Type": "HasHostileTargetMemory"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Combat"
            }
          ]
        },
        {
          "$Comment": "Civ movement target: position slot 0 is the Java/Role contract for ordinary inhabitant movement commands. Explicit player movement stays above autonomous combat.",
          "Sensor": {
            "Type": "ReadPosition",
            "Slot": "CivMoveTarget",
            "MinRange": 0.8,
            "Range": 256
          },
          "BodyMotion": {
            "Type": "Seek",
            "StopDistance": 0.8,
            "SlowDownDistance": 2.0,
            "RelativeSpeed": 0.8,
            "UsePathfinder": true
          }
        },
        {
          "$Comment": "Miner movement target: position slot 1 uses native Hytale pathfinding but rejects best-effort partial paths so an underground target must be reached through a valid route.",
          "Sensor": {
            "Type": "ReadPosition",
            "Slot": "CivMinerMoveTarget",
            "MinRange": 0.8,
            "Range": 256
          },
          "BodyMotion": {
            "Type": "Seek",
            "StopDistance": 0.8,
            "SlowDownDistance": 2.0,
            "RelativeSpeed": 0.8,
            "UsePathfinder": true,
            "UseBestPath": false
          }
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "BodyMotion": {
            "Type": "Nothing"
          }
        }
      ]
    },
    {
      "$Comment": "Soldier combat: Civ selects the hostile target and feeds native TargetMemory; Hytale's Combat Action Evaluator owns pursuit range, sword interaction execution, hit detection, damage, knockback and timing.",
      "Sensor": {
        "Type": "State",
        "State": "Combat"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "HasHostileTargetMemory"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "CombatActionEvaluator",
                    "TargetInRange": true
                  },
                  "HeadMotion": {
                    "Type": "Aim",
                    "RelativeTurnSpeed": 0.5
                  },
                  "BodyMotion": {
                    "Type": "MaintainDistance",
                    "DesiredDistanceRange": [
                      1.5,
                      2.2
                    ],
                    "MoveThreshold": 0.1,
                    "RelativeForwardsSpeed": 0.65,
                    "RelativeBackwardsSpeed": 0.45
                  },
                  "Actions": [
                    {
                      "Type": "CombatAbility"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "CombatActionEvaluator",
                    "TargetInRange": false
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.6,
                    "SlowDownDistance": 3.0,
                    "RelativeSpeed": 1.0,
                    "UsePathfinder": true
                  }
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": "server.npcRoles.Klops_Merchant.name"
}
