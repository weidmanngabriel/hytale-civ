$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 520, Height: 300);

  #Title {
    Group {
      $C.@Title {
        @Text = "Farm abreißen";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Farm wirklich abreißen?";
      Style: (FontSize: 18, TextColor: #ffffff);
      Anchor: (Bottom: 18);
    }

    $C.@TextButton #ConfirmButton {
      @Text = "Ja, abreißen";
      Anchor: (Width: 260, Height: 48);
    }
  }

  $C.@TextButton #CancelButton {
    @Text = "Abbrechen";
    Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44);
  }
}
