$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 700, Height: 570);

  #Title { Group { $C.@Title { @Text = "Wiki · Berufe"; } } }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label { Text: "Holzfäller"; Style: (FontSize: 20, TextColor: #ffffff); }
    Label {
      Text: "Sucht selbständig nahe natürliche Bäume, läuft neben den Stamm und fällt ihn. Hytale erzeugt dabei die normalen Block-Drops.";
      Style: (FontSize: 14, TextColor: #d7dde6);
      Anchor: (Bottom: 8);
    }
    $C.@TextButton #WoodResourceLink { @Text = "→ Ressource: Holz"; Anchor: (Width: 250, Height: 42, Bottom: 18); }

    Label { Text: "Bauer"; Style: (FontSize: 20, TextColor: #ffffff); }
    Label {
      Text: "Wird an der Farm zugewiesen und erhält für den aktuellen Test 4 Weizensaat-Beutel. Er läuft zum nächsten fertigen Weizenfeld und arbeitet dort 5 Sekunden. Danach bringt er 1 Weizen zur Farmtruhe. Beim Berufswechsel wird das Test-Saatgut wieder entfernt.";
      Style: (FontSize: 14, TextColor: #d7dde6);
      Anchor: (Bottom: 8);
    }
    $C.@TextButton #FarmBuildingLink { @Text = "→ Gebäude: Farm"; Anchor: (Width: 250, Height: 42, Bottom: 8); }
    $C.@TextButton #WheatResourceLink { @Text = "→ Ressource: Weizen"; Anchor: (Width: 250, Height: 42); }
  }

  $C.@TextButton #HomeButton { @Text = "← Übersicht"; Anchor: (Bottom: 16, Left: 16, Width: 160, Height: 44); }
  $C.@TextButton #CloseButton { @Text = "Schließen"; Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44); }
}
