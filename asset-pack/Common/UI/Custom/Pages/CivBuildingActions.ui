$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 520, Height: 300);

  #Title {
    Group {
      $C.@Title {
        @Text = "Farm";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Group #ActionsPanel {
      LayoutMode: Top;

      Label {
        Text: "Gebäudeaktionen";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 18);
      }

      $C.@TextButton #DemolishButton {
        @Text = "Abreißen";
        Anchor: (Width: 260, Height: 48);
      }
    }

    Group #ConfirmationPanel {
      Visible: false;
      LayoutMode: Top;

      Label {
        Text: "Farm wirklich abreißen?";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 18);
      }

      $C.@TextButton #ConfirmButton {
        @Text = "Ja, abreißen";
        Anchor: (Width: 260, Height: 48, Bottom: 12);
      }

      $C.@TextButton #CancelButton {
        @Text = "Abbrechen";
        Anchor: (Width: 260, Height: 44);
      }
    }
  }

  $C.@TextButton #CloseButton {
    @Text = "Schließen";
    Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44);
  }
}
