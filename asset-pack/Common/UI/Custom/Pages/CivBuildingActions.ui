$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 560, Height: 500);

  #Title {
    Group {
      $C.@Title {
        @Text = "Gebäude";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Group #ActionsPanel {
      LayoutMode: Top;

      Label #BuildingName {
        Text: "Gebäude";
        Style: (FontSize: 22, TextColor: #ffffff);
        Anchor: (Bottom: 4);
      }

      Label #BuildingMeta {
        Text: "Phase 1";
        Style: (FontSize: 15, TextColor: #b9b9b9);
        Anchor: (Bottom: 18);
      }

      Label #WorkerSummary {
        Text: "Arbeiter 0/0";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 10);
      }

      Group #WorkerList {
        LayoutMode: Top;
        Anchor: (Bottom: 18);
      }

      Label {
        Text: "Gebäudeaktionen";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 10);
      }

      $C.@TextButton #DemolishButton {
        @Text = "Abreißen";
        Anchor: (Width: 260, Height: 48);
      }
    }

    Group #ConfirmationPanel {
      Visible: false;
      LayoutMode: Top;

      Label #ConfirmationText {
        Text: "Gebäude wirklich abreißen?";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 18);
      }

      $C.@TextButton #ConfirmButton {
        @Text = "Ja, abreißen";
        Anchor: (Width: 260, Height: 48, Bottom: 12);
      }

      $C.@TextButton #CancelButton {
        @Text = "Abbrechen";
        Anchor: (Width: 260, Height: 44);
      }
    }
  }

  $C.@TextButton #CloseButton {
    @Text = "Schließen";
    Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44);
  }
}
