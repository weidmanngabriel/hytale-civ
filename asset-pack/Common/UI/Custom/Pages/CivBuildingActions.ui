$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 560, Height: 570);

  #Title {
    Group {
      $C.@Title {
        @Text = "Gebäude";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Group #ActionsPanel {
      LayoutMode: Top;

      Label #BuildingName {
        Text: "Gebäude";
        Style: (FontSize: 22, TextColor: #ffffff);
        Anchor: (Bottom: 4);
      }

      Label #BuildingMeta {
        Text: "Phase 1";
        Style: (FontSize: 15, TextColor: #b9b9b9);
        Anchor: (Bottom: 18);
      }

      Label #WorkerSummary {
        Text: "Arbeiter 0/0";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 10);
      }

      Label #NoWorkerSlots {
        Text: "Keine Arbeitsplätze";
        Style: (FontSize: 16, TextColor: #a9a9a9);
        Anchor: (Bottom: 10);
      }

      Group #WorkerSlot0 {
        Visible: false;
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Label #WorkerLabel0 {
          Text: "Bewohner";
          Style: (FontSize: 16, TextColor: #ffffff);
          Anchor: (Bottom: 4);
        }

        $C.@TextButton #WorkerButton0 {
          @Text = "Auswählen";
          Anchor: (Width: 180, Height: 38);
        }
      }

      Group #WorkerSlot1 {
        Visible: false;
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Label #WorkerLabel1 {
          Text: "Bewohner";
          Style: (FontSize: 16, TextColor: #ffffff);
          Anchor: (Bottom: 4);
        }

        $C.@TextButton #WorkerButton1 {
          @Text = "Auswählen";
          Anchor: (Width: 180, Height: 38);
        }
      }

      Group #WorkerSlot2 {
        Visible: false;
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Label #WorkerLabel2 {
          Text: "Bewohner";
          Style: (FontSize: 16, TextColor: #ffffff);
          Anchor: (Bottom: 4);
        }

        $C.@TextButton #WorkerButton2 {
          @Text = "Auswählen";
          Anchor: (Width: 180, Height: 38);
        }
      }

      Label {
        Text: "Gebäudeaktionen";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 10);
      }

      Label #UpgradeStatus {
        Visible: false;
        Text: "Ausbau läuft. Gebäude gesperrt.";
        Style: (FontSize: 16, TextColor: #d7c28b);
        Anchor: (Bottom: 10);
      }

      $C.@TextButton #UpgradeButton {
        @Text = "Erweitern";
        Visible: false;
        Anchor: (Width: 260, Height: 48, Bottom: 12);
      }

      $C.@TextButton #DemolishButton {
        @Text = "Abreißen";
        Anchor: (Width: 260, Height: 48);
      }
    }

    Group #ConfirmationPanel {
      Visible: false;
      LayoutMode: Top;

      Label #ConfirmationText {
        Text: "Gebäude wirklich abreißen?";
        Style: (FontSize: 18, TextColor: #ffffff);
        Anchor: (Bottom: 18);
      }

      $C.@TextButton #ConfirmButton {
        @Text = "Ja, abreißen";
        Anchor: (Width: 260, Height: 48, Bottom: 12);
      }

      $C.@TextButton #CancelButton {
        @Text = "Abbrechen";
        Anchor: (Width: 260, Height: 44);
      }
    }
  }

  $C.@TextButton #CloseButton {
    @Text = "Schließen";
    Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44);
  }
}
