$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 640, Height: 500);

  #Title { Group { $C.@Title { @Text = "Wiki"; } } }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Kurzhilfe zu den aktuell implementierten Civ-Systemen.";
      Style: (FontSize: 16, TextColor: #d7dde6);
      Anchor: (Bottom: 18);
    }

    $C.@TextButton #ProfessionsButton { @Text = "Berufe"; Anchor: (Width: 300, Height: 48, Bottom: 8); }
    $C.@TextButton #ResourcesButton { @Text = "Ressourcen"; Anchor: (Width: 300, Height: 48, Bottom: 8); }
    $C.@TextButton #BuildingsButton { @Text = "Gebäude"; Anchor: (Width: 300, Height: 48, Bottom: 8); }
    $C.@TextButton #AnimalsButton { @Text = "Tiere"; Anchor: (Width: 300, Height: 48); }
  }

  $C.@TextButton #CloseButton { @Text = "Schließen"; Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44); }
}
