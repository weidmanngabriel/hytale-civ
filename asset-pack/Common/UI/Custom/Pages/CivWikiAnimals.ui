$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 640, Height: 420);

  #Title { Group { $C.@Title { @Text = "Wiki · Tiere"; } } }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Aktuell gibt es noch keine Tiere mit eigener Civ-Funktion.";
      Style: (FontSize: 18, TextColor: #ffffff);
      Anchor: (Bottom: 12);
    }
    Label {
      Text: "Tiere werden hier ergänzt, sobald sie für Berufe, Ressourcen, Produktion oder andere Civ-Systeme relevant sind.";
      Style: (FontSize: 14, TextColor: #aeb6c2);
    }
  }

  $C.@TextButton #HomeButton { @Text = "← Übersicht"; Anchor: (Bottom: 16, Left: 16, Width: 160, Height: 44); }
  $C.@TextButton #CloseButton { @Text = "Schließen"; Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44); }
}
