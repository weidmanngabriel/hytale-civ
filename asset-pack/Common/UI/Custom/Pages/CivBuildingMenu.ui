$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 560, Height: 560);

  #Title {
    Group {
      $C.@Title {
        @Text = "Gebäude";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Gebäude auswählen";
      Style: (FontSize: 18, TextColor: #ffffff);
    }

    Label {
      Text: "Debug-Baumenü · Alphabetisch sortiert";
      Style: (FontSize: 14, TextColor: #aeb6c2);
      Anchor: (Bottom: 16);
    }

    $C.@TextButton #FarmButton {
      @Text = "Farm";
      Anchor: (Width: 300, Height: 48, Bottom: 8);
    }

    $C.@TextButton #Mine1Button {
      @Text = "Mine 1 – Kupfer";
      Anchor: (Width: 300, Height: 48, Bottom: 8);
    }

    $C.@TextButton #Mine2Button {
      @Text = "Mine 2 – Eisen";
      Anchor: (Width: 300, Height: 48, Bottom: 8);
    }

    $C.@TextButton #Mine3Button {
      @Text = "Mine 3 – Gold";
      Anchor: (Width: 300, Height: 48, Bottom: 8);
    }

    $C.@TextButton #FieldButton {
      @Text = "Weizenfeld";
      Anchor: (Width: 300, Height: 48);
    }
  }

  $C.@TextButton #CloseButton {
    @Text = "Schließen";
    Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44);
  }
}
