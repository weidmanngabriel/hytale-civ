$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 700, Height: 520);

  #Title { Group { $C.@Title { @Text = "Wiki · Gebäude"; } } }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label { Text: "Farm"; Style: (FontSize: 20, TextColor: #ffffff); }
    Label {
      Text: "Wird über Bauen → Farm platziert. Der sichtbare Boden wird eine Ebene in das Gelände eingelassen. Ein zugewiesener Bauer läuft zum Eingang, arbeitet innen und produziert lokalen Weizen.";
      Style: (FontSize: 14, TextColor: #d7dde6);
      Anchor: (Bottom: 8);
    }
    Label {
      Text: "Platzierung: Linksklick bestätigt, Rechtsklick bricht ab. Die Fläche wird beim Bestätigen serverseitig erneut geprüft.";
      Style: (FontSize: 14, TextColor: #aeb6c2);
      Anchor: (Bottom: 12);
    }
    $C.@TextButton #FarmerProfessionLink { @Text = "→ Beruf: Bauer"; Anchor: (Width: 250, Height: 42, Bottom: 8); }
    $C.@TextButton #WheatResourceLink { @Text = "→ Ressource: Weizen"; Anchor: (Width: 250, Height: 42); }
  }

  $C.@TextButton #HomeButton { @Text = "← Übersicht"; Anchor: (Bottom: 16, Left: 16, Width: 160, Height: 44); }
  $C.@TextButton #CloseButton { @Text = "Schließen"; Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44); }
}
