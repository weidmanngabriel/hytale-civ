$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 520, Height: 360);

  #Title {
    Group {
      $C.@Title {
        @Text = "Personenaktionen";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Beruf zuweisen";
      Style: (FontSize: 18, TextColor: #ffffff);
    }

    $C.@TextButton #WoodcutterButton {
      @Text = "Holzfäller";
      Anchor: (Width: 220, Height: 44);
    }

    Label {
      Text: "Bewegen nach …  – aktuell per Rechtsklick";
      Style: (FontSize: 15, TextColor: #b8b8b8);
      Anchor: (Top: 24);
    }

    Label {
      Text: "Arbeitsstätte zuweisen – folgt später";
      Style: (FontSize: 15, TextColor: #b8b8b8);
      Anchor: (Top: 10);
    }
  }
}

$C.@BackButton {}
