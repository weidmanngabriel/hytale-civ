$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 520, Height: 420);

  #Title {
    Group {
      $C.@Title {
        @Text = "Personenaktionen";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label {
      Text: "Beruf zuweisen";
      Style: (FontSize: 18, TextColor: #ffffff);
    }

    $C.@TextButton #WoodcutterButton {
      @Text = "Holzfäller";
      Anchor: (Width: 220, Height: 44);
    }

    $C.@TextButton #MinerButton {
      @Text = "Minenabbauer";
      Anchor: (Width: 220, Height: 44, Top: 8);
    }

    $C.@TextButton #ConstructionWorkerButton {
      @Text = "Bauarbeiter";
      Anchor: (Width: 220, Height: 44, Top: 8);
    }

    $C.@TextButton #FarmerButton {
      @Text = "Bauer";
      Anchor: (Width: 220, Height: 44, Top: 8);
    }

    Label {
      Text: "Bewohner";
      Style: (FontSize: 18, TextColor: #ffffff);
      Anchor: (Top: 20);
    }

    $C.@TextButton #InventoryButton {
      @Text = "Inventar ansehen";
      Anchor: (Width: 220, Height: 44, Top: 8);
    }

    Label {
      Text: "Bewegen nach …  – aktuell per Rechtsklick";
      Style: (FontSize: 15, TextColor: #b8b8b8);
      Anchor: (Top: 24);
    }

    Label {
      Text: "Bauer/Minenabbauer: anschließend Gebäude per Rechtsklick zuweisen";
      Style: (FontSize: 15, TextColor: #b8b8b8);
      Anchor: (Top: 10);
    }
  }
}

$C.@BackButton {}
