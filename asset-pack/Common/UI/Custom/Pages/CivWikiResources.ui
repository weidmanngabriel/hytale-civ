$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Left: 170, Width: 700, Height: 570);

  #Title { Group { $C.@Title { @Text = "Wiki · Ressourcen"; } } }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Label { Text: "Holz"; Style: (FontSize: 20, TextColor: #ffffff); }
    Label {
      Text: "Entsteht derzeit über Hytales normalen Baumabbau. Der Civ-Holzfäller fällt den Stamm über Hytales native Block-Harvest-Logik; ein eigenes Civ-Holzlager gibt es noch nicht.";
      Style: (FontSize: 14, TextColor: #d7dde6);
      Anchor: (Bottom: 8);
    }
    $C.@TextButton #WoodcutterProfessionLink { @Text = "→ Beruf: Holzfäller"; Anchor: (Width: 250, Height: 42, Bottom: 18); }

    Label { Text: "Weizen"; Style: (FontSize: 20, TextColor: #ffffff); }
    Label {
      Text: "Weizen wird als echter Hytale-Gegenstand in der vorhandenen Farmtruhe gelagert. Der Bauer bringt nach jeder Feldarbeit 1 Weizen zurück; bei voller Truhe wartet die Produktion beim Einlagern.";
      Style: (FontSize: 14, TextColor: #d7dde6);
      Anchor: (Bottom: 8);
    }
    $C.@TextButton #FarmerProfessionLink { @Text = "→ Beruf: Bauer"; Anchor: (Width: 250, Height: 42, Bottom: 8); }
    $C.@TextButton #FarmBuildingLink { @Text = "→ Gebäude: Farm"; Anchor: (Width: 250, Height: 42); }
  }

  $C.@TextButton #HomeButton { @Text = "← Übersicht"; Anchor: (Bottom: 16, Left: 16, Width: 160, Height: 44); }
  $C.@TextButton #CloseButton { @Text = "Schließen"; Anchor: (Bottom: 16, Right: 16, Width: 160, Height: 44); }
}
