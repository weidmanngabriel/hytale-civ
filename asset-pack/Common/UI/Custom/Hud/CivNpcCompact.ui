Group {
  Group #NpcCompactPanel {
    Anchor: (Right: 24, Bottom: 118, Width: 340, Height: 300);
    LayoutMode: Top;
    Padding: (Left: 14, Right: 14, Top: 12, Bottom: 12);
    Background: #131D30(0.90);

    Label #NpcName {
      Text: "Bewohner";
      Anchor: (Height: 24);
      Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
    }

    Label #Profession {
      Text: "Arbeitslos";
      Anchor: (Height: 20, Top: 2);
      Style: (FontSize: 15, TextColor: #c9d4e8);
    }

    Group {
      Anchor: (Height: 1, Top: 8, Bottom: 8);
      Background: #60708a(0.55);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22);
      Label { Text: "Tätigkeit"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Activity { Text: "Wartet"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Erfahrung"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Experience { Text: "0 XP"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Lebenspunkte"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Health { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Waffe"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Weapon { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Kampf"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #CombatStatus { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Ziel"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #CombatTarget { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #ffffff); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Hunger"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Hunger { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #7f8b9d); }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 22, Top: 3);
      Label { Text: "Wohnung"; Anchor: (Width: 92); Style: (FontSize: 14, TextColor: #93a2b8); }
      Label #Home { Text: "—"; FlexWeight: 1; Style: (FontSize: 14, TextColor: #7f8b9d); }
    }
  }
}