$C = "../Common.ui";

Group #RtsToolbar {
  Anchor: (Left: 16, Top: 220, Width: 124, Height: 136);
  Background: PatchStyle(Color: #161b22E8);
  Padding: (Full: 8);
  LayoutMode: Top;

  $C.@TextButton #BuildButton {
    @Text = "Bauen";
    Anchor: (Width: 108, Height: 56, Bottom: 8);
  }

  $C.@TextButton #WikiButton {
    @Text = "?";
    Anchor: (Width: 108, Height: 56);
  }
}
